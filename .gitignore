# Swift Package Manager build artifacts (regenerable; ~1.7 GB)
.build/
.swiftpm/
Package.pins

# Assembled app bundle (a build output of Scripts/build_app.sh)
*.app/

# Xcode. NOTE: an .xcodeproj is NOT ignored — the future iOS app target needs one committed,
# so a fresh clone builds with no setup step. Only Xcode's per-user state is ignored.
DerivedData/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/
xcuserdata/

# Machine-local Claude Code settings (permission allowlist; not portable)
.claude/

# macOS cruft
.DS_Store
**/.DS_Store

# Build/test scratch
/tmp/
*.log
