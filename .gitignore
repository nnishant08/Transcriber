# Swift Package Manager build artifacts (regenerable; ~1.7 GB)
.build/
.swiftpm/
Package.pins

# Assembled app bundle (a build output of Scripts/build_app.sh)
Transcriber.app/
*.app/

# Xcode / DerivedData (not used for the build, but ignore defensively)
DerivedData/
*.xcodeproj/project.xcworkspace/xcuserdata/
xcuserdata/

# Machine-local Claude Code settings (permission allowlist; not portable)
.claude/

# macOS cruft
.DS_Store
**/.DS_Store

# Build/test scratch
/tmp/
*.log
